# Server Environment
NODE_ENV=development
PORT=5000

# Database Configuration (Replica set required for transactions)
# For local Docker replica set: mongodb://localhost:27017/veloop_rewards?replicaSet=rs0
# For Atlas: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/veloop_rewards?retryWrites=true&w=majority
MONGO_URI=mongodb://localhost:27017/veloop_rewards?replicaSet=rs0

# JWT Auth
JWT_SECRET=demo_jwt_secret_change_in_production_super_secure_key_12345
JWT_EXPIRES_IN=7d

# CORS
CORS_ORIGIN=http://localhost:5173

# Admin Bootstrap
ADMIN_BOOTSTRAP_EMAIL=admin@veloop.test
ADMIN_BOOTSTRAP_PASSWORD=AdminPass123!

# Rate Limiting
RATE_LIMIT_GLOBAL_WINDOW_MS=900000
RATE_LIMIT_GLOBAL_MAX=500
RATE_LIMIT_AUTH_WINDOW_MS=900000
RATE_LIMIT_AUTH_MAX=20
RATE_LIMIT_WITHDRAWAL_WINDOW_MS=3600000
RATE_LIMIT_WITHDRAWAL_MAX=10

# Security / Risk Config
DAILY_WITHDRAWAL_CAP_VES=200000
MAX_WITHDRAWAL_ATTEMPTS_PER_HOUR=5
INTERNAL_API_KEY=internal_secret_key_demo_change_in_production

# Seeding Flags
SEED_ALLOW_PROD=false

