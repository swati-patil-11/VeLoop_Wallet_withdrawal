{
  "info": {
    "_postman_id": "veloop-rewards-postman-collection",
    "name": "VELoop Rewards Wallet & Payout System",
    "description": "Comprehensive API collection for VELoop Rewards Wallet, Double-Entry Ledger, Payout Options, and Withdrawal Review Lifecycle.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Authentication",
      "item": [
        {
          "name": "Login (Demo User)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.token) {",
                  "    pm.environment.set('authToken', json.token);",
                  "    pm.test('Token received', () => pm.expect(json.token).to.be.a('string'));",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"demo@veloop.test\",\n  \"password\": \"DemoUser123!\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/auth/login", "host": ["{{baseUrl}}"], "path": ["auth", "login"] }
          }
        },
        {
          "name": "Login (Admin)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.token) {",
                  "    pm.environment.set('adminToken', json.token);",
                  "    pm.test('Admin token received', () => pm.expect(json.token).to.be.a('string'));",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@veloop.test\",\n  \"password\": \"AdminPass123!\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/auth/login", "host": ["{{baseUrl}}"], "path": ["auth", "login"] }
          }
        },
        {
          "name": "Get Current Profile (Me)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{authToken}}" }
            ],
            "url": { "raw": "{{baseUrl}}/auth/me", "host": ["{{baseUrl}}"], "path": ["auth", "me"] }
          }
        }
      ]
    },
    {
      "name": "2. Wallet & Ledger",
      "item": [
        {
          "name": "Get Wallet Balances",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{authToken}}" }],
            "url": { "raw": "{{baseUrl}}/wallet", "host": ["{{baseUrl}}"], "path": ["wallet"] }
          }
        },
        {
          "name": "Get Wallet Summary (Balances + Recent + Pending)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{authToken}}" }],
            "url": { "raw": "{{baseUrl}}/wallet/summary", "host": ["{{baseUrl}}"], "path": ["wallet", "summary"] }
          }
        },
        {
          "name": "Get Transactions (Paginated)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{authToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/wallet/transactions?page=1&limit=10",
              "host": ["{{baseUrl}}"],
              "path": ["wallet", "transactions"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "10" }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "3. Payout Configuration",
      "item": [
        {
          "name": "Get Active Payout Methods",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{authToken}}" }],
            "url": { "raw": "{{baseUrl}}/payout/methods", "host": ["{{baseUrl}}"], "path": ["payout", "methods"] }
          }
        },
        {
          "name": "Get Options for Method (UPI)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{authToken}}" }],
            "url": { "raw": "{{baseUrl}}/payout/options/upi", "host": ["{{baseUrl}}"], "path": ["payout", "options", "upi"] }
          }
        }
      ]
    },
    {
      "name": "4. Withdrawals & State Machine",
      "item": [
        {
          "name": "Create Withdrawal (Idempotent)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "const uuid = require('uuid').v4();",
                  "pm.environment.set('idempotencyKey', uuid);"
                ],
                "type": "text/javascript"
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.withdrawal && json.withdrawal.withdrawalId) {",
                  "    pm.environment.set('withdrawalId', json.withdrawal.withdrawalId);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{authToken}}" },
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Idempotency-Key", "value": "{{idempotencyKey}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"method\": \"upi\",\n  \"optionId\": \"upi_10\",\n  \"payoutDetails\": {\n    \"upiId\": \"demo@okaxis\"\n  }\n}"
            },
            "url": { "raw": "{{baseUrl}}/withdrawals", "host": ["{{baseUrl}}"], "path": ["withdrawals"] }
          }
        },
        {
          "name": "Duplicate Withdrawal (Same Idempotency-Key)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{authToken}}" },
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Idempotency-Key", "value": "{{idempotencyKey}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"method\": \"upi\",\n  \"optionId\": \"upi_10\",\n  \"payoutDetails\": {\n    \"upiId\": \"demo@okaxis\"\n  }\n}"
            },
            "url": { "raw": "{{baseUrl}}/withdrawals", "host": ["{{baseUrl}}"], "path": ["withdrawals"] }
          }
        },
        {
          "name": "Get User Withdrawals",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{authToken}}" }],
            "url": { "raw": "{{baseUrl}}/withdrawals", "host": ["{{baseUrl}}"], "path": ["withdrawals"] }
          }
        },
        {
          "name": "Cancel Pending Withdrawal (Refunds VEs)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{authToken}}" }],
            "url": { "raw": "{{baseUrl}}/withdrawals/{{withdrawalId}}/cancel", "host": ["{{baseUrl}}"], "path": ["withdrawals", "{{withdrawalId}}", "cancel"] }
          }
        }
      ]
    },
    {
      "name": "5. Admin Review & Operations",
      "item": [
        {
          "name": "Admin: Get All Withdrawals",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "url": { "raw": "{{baseUrl}}/admin/withdrawals", "host": ["{{baseUrl}}"], "path": ["admin", "withdrawals"] }
          }
        },
        {
          "name": "Admin: Move to PROCESSING",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{adminToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"reviewNote\": \"Gateway processing queued\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/admin/withdrawals/{{withdrawalId}}/processing", "host": ["{{baseUrl}}"], "path": ["admin", "withdrawals", "{{withdrawalId}}", "processing"] }
          }
        },
        {
          "name": "Admin: Approve Withdrawal",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{adminToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"reviewNote\": \"Transfer verified and complete\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/admin/withdrawals/{{withdrawalId}}/approve", "host": ["{{baseUrl}}"], "path": ["admin", "withdrawals", "{{withdrawalId}}", "approve"] }
          }
        },
        {
          "name": "Admin: Reject Withdrawal (Compensating Refund)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{adminToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"rejectionReason\": \"Invalid UPI bank identifier\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/admin/withdrawals/{{withdrawalId}}/reject", "host": ["{{baseUrl}}"], "path": ["admin", "withdrawals", "{{withdrawalId}}", "reject"] }
          }
        },
        {
          "name": "Admin: Get Ledger Transactions",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "url": { "raw": "{{baseUrl}}/admin/transactions", "host": ["{{baseUrl}}"], "path": ["admin", "transactions"] }
          }
        },
        {
          "name": "Admin: Get Audit Logs",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "url": { "raw": "{{baseUrl}}/admin/audit-logs", "host": ["{{baseUrl}}"], "path": ["admin", "audit-logs"] }
          }
        }
      ]
    },
    {
      "name": "6. Negative & Security Edge Cases",
      "item": [
        {
          "name": "Negative: Tamper Attack (Send Malicious Amount -> 400)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{authToken}}" },
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Idempotency-Key", "value": "c8d20387-57bc-4f9e-9d8a-821213f56d9a" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"method\": \"upi\",\n  \"optionId\": \"upi_10\",\n  \"requiredAmount\": 1,\n  \"payoutDetails\": { \"upiId\": \"user@bank\" }\n}"
            },
            "url": { "raw": "{{baseUrl}}/withdrawals", "host": ["{{baseUrl}}"], "path": ["withdrawals"] }
          }
        },
        {
          "name": "Negative: Insufficient Balance (Expect 400)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{authToken}}" },
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Idempotency-Key", "value": "d7e30387-57bc-4f9e-9d8a-821213f56d9b" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"method\": \"upi\",\n  \"optionId\": \"upi_1000\",\n  \"payoutDetails\": { \"upiId\": \"user@bank\" }\n}"
            },
            "url": { "raw": "{{baseUrl}}/withdrawals", "host": ["{{baseUrl}}"], "path": ["withdrawals"] }
          }
        },
        {
          "name": "Negative: Normal User Calls Admin Endpoint (Expect 403)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{authToken}}" }],
            "url": { "raw": "{{baseUrl}}/admin/withdrawals", "host": ["{{baseUrl}}"], "path": ["admin", "withdrawals"] }
          }
        }
      ]
    }
  ]
}

